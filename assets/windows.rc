// Keep the application icon first: Explorer uses the first icon group.
LANGUAGE 0, 0

// Setup and the application operate only on the current user's files/settings.
1 24 "assets/windows.manifest"

101 ICON "assets/icons/bucket-mount.ico"
201 ICON "assets/icons/tray-on-dark-idle.ico"
202 ICON "assets/icons/tray-on-dark-syncing.ico"
203 ICON "assets/icons/tray-on-dark-paused.ico"
204 ICON "assets/icons/tray-on-dark-error.ico"
211 ICON "assets/icons/tray-on-light-idle.ico"
212 ICON "assets/icons/tray-on-light-syncing.ico"
213 ICON "assets/icons/tray-on-light-paused.ico"
214 ICON "assets/icons/tray-on-light-error.ico"

1 VERSIONINFO
FILEVERSION @FILE_VERSION@
PRODUCTVERSION @FILE_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Bucket Mount\0"
            VALUE "FileVersion", "@PACKAGE_VERSION@\0"
            VALUE "InternalName", "bucket-mount\0"
            VALUE "OriginalFilename", "bucket-mount.exe\0"
            VALUE "ProductName", "Bucket Mount\0"
            VALUE "ProductVersion", "@PACKAGE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
